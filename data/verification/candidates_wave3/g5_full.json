[
  {"id": "p5_051", "item_type": "fill", "stem": "由 6 个一、3 个 0.1 和 2 个 0.01 组成的数是____。", "answer": "6.32", "kps": ["kp_p5_decimal_meaning"], "difficulty": 0.30, "solution": "把各位计数单位的个数按数位顺序排列：个位 6、十分位 3、百分位 2，组成的数是 6.32。", "source": "llm_generated"},
  {"id": "p5_052", "item_type": "choice", "stem": "把 4.8 改写成两位小数是（　）", "options": ["A. 4.80", "B. 4.08", "C. 4.8", "D. 48.0"], "answer": "A", "kps": ["kp_p5_decimal_meaning"], "difficulty": 0.55, "solution": "根据小数性质，小数末尾添 0 大小不变，4.8 = 4.80，所以选 A。", "source": "llm_generated"},
  {"id": "p5_053", "item_type": "fill", "stem": "一个三位小数四舍五入到百分位后约等于 6.30，这个三位小数最小是____。", "answer": "6.295", "kps": ["kp_p5_decimal_meaning"], "difficulty": 0.70, "solution": "四舍五入到百分位约等于 6.30 的三位小数，个位是 6、百分位是 3、最小千分位要使原数最小但能进位到 6.30，所以是 6.295。", "source": "llm_generated"},
  {"id": "p5_054", "item_type": "fill", "stem": "计算：3.6 + 0.45 = ____。", "answer": "4.05", "kps": ["kp_p5_decimal_add_sub"], "difficulty": 0.25, "solution": "把 3.6 写成 3.60，小数点对齐后相加：百分位 0+5=5，十分位 6+4=10 写 0 进 1，个位 3+0+1=4，得 4.05。", "source": "llm_generated"},
  {"id": "p5_055", "item_type": "fill", "stem": "计算：5.6 + 2.34 = ____。", "answer": "7.94", "kps": ["kp_p5_decimal_add_sub"], "difficulty": 0.45, "solution": "把 5.6 写成 5.60，小数点对齐后相加：6+4=10 写 0 进 1；5+3+1=9；个位 5+2=7，得 7.94。", "source": "llm_generated"},
  {"id": "p5_056", "item_type": "choice", "stem": "下面哪个算式的结果是 1.8？（　）", "options": ["A. 3.5－1.7", "B. 4.6－2.5", "C. 5.4－3.7", "D. 6.7－4.8"], "answer": "A", "kps": ["kp_p5_decimal_add_sub"], "difficulty": 0.60, "solution": "逐项计算：A. 3.5－1.7 = 1.8；B. 4.6－2.5 = 2.1；C. 5.4－3.7 = 1.7；D. 6.7－4.8 = 1.9，只有 A 的结果是 1.8。", "source": "llm_generated"},
  {"id": "p5_057", "item_type": "fill", "stem": "计算：0.6 × 0.4 = ____。", "answer": "0.24", "kps": ["kp_p5_decimal_mul"], "difficulty": 0.25, "solution": "先按整数乘法算 6×4=24，两个因数共有两位小数，从右向左数两位点上小数点，得 0.24。", "source": "llm_generated"},
  {"id": "p5_058", "item_type": "fill", "stem": "每支铅笔 1.25 元，买 8 支铅笔需要____元。", "answer": "10", "kps": ["kp_p5_decimal_mul"], "difficulty": 0.50, "solution": "总价 = 单价×数量：1.25×8 = 10（元）。", "source": "llm_generated"},
  {"id": "p5_059", "item_type": "choice", "stem": "两个因数的积是 8.4，如果一个因数不变，另一个因数扩大到原来的 10 倍，那么积是（　）", "options": ["A. 0.84", "B. 8.4", "C. 84", "D. 840"], "answer": "C", "kps": ["kp_p5_decimal_mul"], "difficulty": 0.65, "solution": "一个因数不变，另一个因数扩大到原来的 10 倍，积也跟着扩大到原来的 10 倍：8.4×10 = 84，选 C。", "source": "llm_generated"},
  {"id": "p5_060", "item_type": "fill", "stem": "计算：6.5 ÷ 5 = ____。", "answer": "1.3", "kps": ["kp_p5_decimal_div"], "difficulty": 0.20, "solution": "除数是整数，按整数除法计算：65÷5=13，被除数是一位小数，商也是一位小数，即 1.3。", "source": "llm_generated"},
  {"id": "p5_061", "item_type": "fill", "stem": "把 7.2 米长的绳子平均剪成 4 段，每段长____米。", "answer": "1.8", "kps": ["kp_p5_decimal_div"], "difficulty": 0.40, "solution": "每段长 = 总长÷段数：7.2÷4 = 1.8（米）。", "source": "llm_generated"},
  {"id": "p5_062", "item_type": "choice", "stem": "做一件衣服需要 2.4 米布，12 米布最多可以做（　）件这样的衣服。", "options": ["A. 4", "B. 5", "C. 6", "D. 8"], "answer": "B", "kps": ["kp_p5_decimal_div"], "difficulty": 0.55, "solution": "12÷2.4 = 5，最多可以做 5 件，选 B。", "source": "llm_generated"},
  {"id": "p5_063", "item_type": "fill", "stem": "计算：2.5 × 4 - 3.6 = ____。", "answer": "6.4", "kps": ["kp_p5_mixed_ops"], "difficulty": 0.30, "solution": "先算乘法：2.5×4 = 10；再算减法：10 - 3.6 = 6.4。", "source": "llm_generated"},
  {"id": "p5_064", "item_type": "choice", "stem": "下面计算正确的是（　）", "options": ["A. 4.5－2.5×0.4 = 2", "B. 4.5－2.5×0.4 = 3.5", "C. 4.5－2.5×0.4 = 3", "D. 4.5－2.5×0.4 = 2.5"], "answer": "B", "kps": ["kp_p5_mixed_ops"], "difficulty": 0.50, "solution": "先算乘法 2.5×0.4 = 1，再算减法 4.5 - 1 = 3.5，所以选 B。", "source": "llm_generated"},
  {"id": "p5_065", "item_type": "fill", "stem": "用简便方法计算：0.25 × 4.8 + 0.25 × 5.2 = ____。", "answer": "2.5", "kps": ["kp_p5_mixed_ops"], "difficulty": 0.65, "solution": "利用乘法分配律的逆运算：0.25×(4.8+5.2) = 0.25×10 = 2.5。", "source": "llm_generated"},
  {"id": "p5_066", "item_type": "choice", "stem": "下面四组数中，全部都是合数的是（　）", "options": ["A. 1、2、3、5", "B. 4、6、8、9", "C. 6、8、11、15", "D. 2、4、6、8"], "answer": "B", "kps": ["kp_p5_factor_multiple"], "difficulty": 0.50, "solution": "1 既不是质数也不是合数；2、3、5、11 是质数；4、6、8、9、15 都是合数。只有 B 组全部是合数。", "source": "llm_generated"},
  {"id": "p5_067", "item_type": "fill", "stem": "把 5/6 化成分子是 10 而大小不变的分数是____。", "answer": "10/12", "kps": ["kp_p5_fraction_meaning"], "difficulty": 0.25, "solution": "根据分数基本性质，分子分母同时乘 2：5×2=10，6×2=12，得 10/12。", "source": "llm_generated"},
  {"id": "p5_068", "item_type": "fill", "stem": "把 14/42 约分后是____。", "answer": "1/3", "kps": ["kp_p5_fraction_meaning"], "difficulty": 0.45, "solution": "14 和 42 的最大公因数是 14，分子分母同时除以 14：14÷14=1，42÷14=3，得 1/3。", "source": "llm_generated"},
  {"id": "p5_069", "item_type": "choice", "stem": "下面分数中，最小的是（　）", "options": ["A. 1/2", "B. 3/8", "C. 5/12", "D. 7/16"], "answer": "B", "kps": ["kp_p5_fraction_meaning"], "difficulty": 0.65, "solution": "通分到 48 作公分母：1/2=24/48，3/8=18/48，5/12=20/48，7/16=21/48，其中 18/48 最小，对应 3/8。", "source": "llm_generated"},
  {"id": "p5_070", "item_type": "fill", "stem": "计算：1/4 + 1/4 = ____。", "answer": "1/2", "kps": ["kp_p5_fraction_add_sub"], "difficulty": 0.25, "solution": "同分母分数相加，分母不变，分子相加：1+1=2，结果 2/4，约分后是 1/2。", "source": "llm_generated"},
  {"id": "p5_071", "item_type": "fill", "stem": "计算：5/6 - 1/4 = ____。", "answer": "7/12", "kps": ["kp_p5_fraction_add_sub"], "difficulty": 0.45, "solution": "通分到 12：5/6=10/12，1/4=3/12，10/12-3/12=7/12。", "source": "llm_generated"},
  {"id": "p5_072", "item_type": "choice", "stem": "一根绳子第一次用去 1/3 米，第二次用去 1/4 米，两次一共用去（　）米。", "options": ["A. 5/12", "B. 7/12", "C. 1/2", "D. 1/7"], "answer": "B", "kps": ["kp_p5_fraction_add_sub"], "difficulty": 0.60, "solution": "1/3 + 1/4，通分到 12：4/12 + 3/12 = 7/12（米），选 B。", "source": "llm_generated"},
  {"id": "p5_073", "item_type": "fill", "stem": "一个三角形的底是 8 米，高是 5 米，它的面积是____平方米。", "answer": "20", "kps": ["kp_p5_polygon_area"], "difficulty": 0.25, "solution": "三角形面积 = 底×高÷2：8×5÷2 = 20（平方米）。", "source": "llm_generated"},
  {"id": "p5_074", "item_type": "choice", "stem": "一个梯形的上底是 6 米，下底是 10 米，高是 4 米，它的面积是（　）平方米。", "options": ["A. 64", "B. 32", "C. 16", "D. 40"], "answer": "B", "kps": ["kp_p5_polygon_area"], "difficulty": 0.45, "solution": "梯形面积 = (上底+下底)×高÷2：(6+10)×4÷2 = 32（平方米），选 B。", "source": "llm_generated"},
  {"id": "p5_075", "item_type": "fill", "stem": "一个平行四边形和一个三角形面积相等，高也相等，平行四边形的底是 12 米，三角形的底是____米。", "answer": "24", "kps": ["kp_p5_polygon_area"], "difficulty": 0.65, "solution": "设三角形底为 b，高都为 h。12×h = b×h÷2，得 b = 24（米）。", "source": "llm_generated"},
  {"id": "p5_076", "item_type": "fill", "stem": "一个正方体的棱长是 4 分米，它的体积是____立方分米。", "answer": "64", "kps": ["kp_p5_cuboid_volume"], "difficulty": 0.25, "solution": "正方体体积 = 棱长×棱长×棱长：4×4×4 = 64（立方分米）。", "source": "llm_generated"},
  {"id": "p5_077", "item_type": "choice", "stem": "棱长是 6 厘米的正方体，它的表面积与体积相比（　）", "options": ["A. 表面积大", "B. 体积大", "C. 一样大", "D. 无法比较"], "answer": "D", "kps": ["kp_p5_cuboid_volume"], "difficulty": 0.45, "solution": "表面积是 6×6×6=216 平方厘米，体积是 216 立方厘米，单位不同不能直接比较大小，选 D。", "source": "llm_generated"},
  {"id": "p5_078", "item_type": "fill", "stem": "一个长方体的长是 8 厘米，宽是 5 厘米，高是 4 厘米，它的表面积是____平方厘米。", "answer": "184", "kps": ["kp_p5_cuboid_volume"], "difficulty": 0.65, "solution": "长方体表面积 = 2×(长×宽+长×高+宽×高) = 2×(40+32+20) = 184（平方厘米）。", "source": "llm_generated"},
  {"id": "p5_079", "item_type": "fill", "stem": "小红在第 3 列第 6 行，用数对表示她的位置是____。", "answer": "(3,6)", "kps": ["kp_p5_coord_pairs"], "difficulty": 0.25, "solution": "数对的第一个数表示列数，第二个数表示行数，第 3 列第 6 行用数对表示是 (3,6)。", "source": "llm_generated"},
  {"id": "p5_080", "item_type": "choice", "stem": "下面数对中，表示位置在 (3,4) 右下方的是（　）", "options": ["A. (3,5)", "B. (4,3)", "C. (4,5)", "D. (5,3)"], "answer": "C", "kps": ["kp_p5_coord_pairs"], "difficulty": 0.40, "solution": "右下方指列数更大且行数更大：列数要大于 3，行数要大于 4，(4,5) 符合，选 C。", "source": "llm_generated"},
  {"id": "p5_081", "item_type": "fill", "stem": "在方格纸上，三个点的位置用数对分别表示为 (1,5)、(3,5)、(5,5)，这三个点都在第____行上。", "answer": "5", "kps": ["kp_p5_coord_pairs"], "difficulty": 0.55, "solution": "数对的第二个数表示行数，三个点的第二个数都是 5，所以都在第 5 行。", "source": "llm_generated"},
  {"id": "p5_082", "item_type": "fill", "stem": "一个点从 (6,4) 出发，向左平移 2 格后到达的位置用数对表示是____。", "answer": "(4,4)", "kps": ["kp_p5_graph_motion"], "difficulty": 0.25, "solution": "向左平移列数减小：6 - 2 = 4，行数不变，所以新位置是 (4,4)。", "source": "llm_generated"},
  {"id": "p5_083", "item_type": "choice", "stem": "把一个图形绕中心点逆时针旋转 90° 后，图形的大小和形状（　）", "options": ["A. 变了", "B. 没变", "C. 大小变了形状没变", "D. 大小没变形状变了"], "answer": "B", "kps": ["kp_p5_graph_motion"], "difficulty": 0.45, "solution": "旋转只改变图形的位置，不改变大小和形状，所以选 B。", "source": "llm_generated"},
  {"id": "p5_084", "item_type": "fill", "stem": "一个图形向下平移 3 格后，原来在 (4,2) 的顶点现在在____。", "answer": "(4,5)", "kps": ["kp_p5_graph_motion"], "difficulty": 0.65, "solution": "向下平移行数增加：2 + 3 = 5，列数不变，所以新位置是 (4,5)。", "source": "llm_generated"},
  {"id": "p5_085", "item_type": "fill", "stem": "看一张折线统计图，纵轴每格代表 5 千克。某周周一产奶 30 千克，周五产奶 60 千克，周五比周一多产____千克。", "answer": "30", "kps": ["kp_p5_line_graph"], "difficulty": 0.25, "solution": "读出两天数据后相减：60 - 30 = 30（千克）。", "source": "llm_generated"},
  {"id": "p5_086", "item_type": "choice", "stem": "看一张气温折线图，某日 6 时气温 14℃，10 时气温 20℃，14 时气温 26℃，18 时气温 22℃，气温最高的时间是（　）", "options": ["A. 6时", "B. 10时", "C. 14时", "D. 18时"], "answer": "C", "kps": ["kp_p5_line_graph"], "difficulty": 0.45, "solution": "比较四个时段的气温：14℃、20℃、26℃、22℃，14 时最高 26℃，选 C。", "source": "llm_generated"},
  {"id": "p5_087", "item_type": "fill", "stem": "看一张折线统计图，周一行 80 千米，周二 100 千米，周三 90 千米，周四 110 千米，周五 95 千米。这五天平均每天行____千米。", "answer": "95", "kps": ["kp_p5_line_graph"], "difficulty": 0.65, "solution": "总路程 80+100+90+110+95=475（千米），平均每天 475÷5 = 95（千米）。", "source": "llm_generated"},
  {"id": "p5_088", "item_type": "fill", "stem": "盒子里有 4 个白球和 1 个黑球，任意摸出一个球，摸到____球的可能性大。", "answer": "白", "kps": ["kp_p5_possibility"], "difficulty": 0.25, "solution": "球的数量越多摸到的可能性越大，白球有 4 个比黑球多，所以摸到白球的可能性大。", "source": "llm_generated"},
  {"id": "p5_089", "item_type": "choice", "stem": "一个口袋里放着大小相同的红、黄、蓝、绿 4 个球，任意摸一个再放回，连摸两次都摸到红球的可能性（　）", "options": ["A. 很大", "B. 不大", "C. 不可能", "D. 一定"], "answer": "B", "kps": ["kp_p5_possibility"], "difficulty": 0.45, "solution": "4 个球中只有 1 个红球，每次摸到红球的可能性是 1/4，连摸两次都摸到的可能性很小，所以选 B。", "source": "llm_generated"},
  {"id": "p5_090", "item_type": "fill", "stem": "掷一个骰子，朝上的点数大于 4 的可能性有____种。", "answer": "2", "kps": ["kp_p5_possibility"], "difficulty": 0.60, "solution": "骰子朝上的点数可以是 1~6 共 6 种，其中大于 4 的是 5 和 6 共 2 种。", "source": "llm_generated"},
  {"id": "p5_091", "item_type": "fill", "stem": "一辆汽车每小时行驶 65 千米，t 小时行驶____千米。", "answer": "65t", "kps": ["kp_p5_letter_number"], "difficulty": 0.25, "solution": "路程 = 速度×时间：65×t = 65t（千米）。", "source": "llm_generated"},
  {"id": "p5_092", "item_type": "choice", "stem": "当 a = 5 时，a² 和 2a 的大小关系是（　）", "options": ["A. a² > 2a", "B. a² < 2a", "C. a² = 2a", "D. 不能比较"], "answer": "A", "kps": ["kp_p5_letter_number"], "difficulty": 0.45, "solution": "a² = 5×5 = 25，2a = 2×5 = 10，25 > 10，所以 a² > 2a，选 A。", "source": "llm_generated"},
  {"id": "p5_093", "item_type": "fill", "stem": "三个连续的自然数，中间一个是 m，那么这三个数的和是____。", "answer": "3m", "kps": ["kp_p5_letter_number"], "difficulty": 0.60, "solution": "三个连续自然数为 m-1、m、m+1，和是 (m-1) + m + (m+1) = 3m。", "source": "llm_generated"},
  {"id": "p5_094", "item_type": "fill", "stem": "一条走廊长 40 米，每隔 5 米挂一盏灯（两端都挂），一共要挂____盏灯。", "answer": "9", "kps": ["kp_p5_tree_planting"], "difficulty": 0.25, "solution": "间隔数：40÷5 = 8（个），两端都挂时盏数 = 间隔数 + 1 = 9（盏）。", "source": "llm_generated"},
  {"id": "p5_095", "item_type": "choice", "stem": "一条路长 50 米，在路的一边每隔 5 米种一棵树（两端都不种），一共要种（　）棵树。", "options": ["A. 9", "B. 10", "C. 11", "D. 8"], "answer": "A", "kps": ["kp_p5_tree_planting"], "difficulty": 0.45, "solution": "间隔数：50÷5 = 10（个），两端都不种时棵数 = 间隔数 - 1 = 9（棵），选 A。", "source": "llm_generated"},
  {"id": "p5_096", "item_type": "fill", "stem": "一条长 80 米的路每隔 4 米种一棵树（两端都种），后来因为改建，起点和终点的树都拔掉，现在还剩____棵树。", "answer": "19", "kps": ["kp_p5_tree_planting"], "difficulty": 0.65, "solution": "原来间隔数：80÷4 = 20（个），两端都种共 21 棵，拔掉起点和终点共 2 棵后，剩 21-2 = 19（棵）。", "source": "llm_generated"}
]
