[
  {"id": "p6_052", "item_type": "fill", "stem": "计算：3/8 × 4/9 = ____", "answer": "1/6", "kps": ["kp_p6_fraction_mul"], "difficulty": 0.2, "solution": "分数乘分数,分子相乘分母相乘再约分：3×4/(8×9) = 12/72 = 1/6。", "source": "llm_generated"},
  {"id": "p6_053", "item_type": "choice", "stem": "下面各式中,结果最大的是（　）", "options": ["A. 1/2 × 1/3", "B. 1/2 × 2/3", "C. 1/2 × 1", "D. 1/2 × 0"], "answer": "C", "kps": ["kp_p6_fraction_mul"], "difficulty": 0.4, "solution": "A=1/6≈0.167,B=1/3≈0.333,C=1/2=0.5,D=0;最大为 C 的 1/2。", "source": "llm_generated"},
  {"id": "p6_054", "item_type": "fill", "stem": "计算：2/3 × 3/4 × 4/5 = ____", "answer": "2/5", "kps": ["kp_p6_fraction_mul"], "difficulty": 0.55, "solution": "三个分数连乘,分子分母分别相乘：2×3×4/(3×4×5) = 24/60 = 2/5。", "source": "llm_generated"},
  {"id": "p6_055", "item_type": "fill", "stem": "计算：6/7 ÷ 3 = ____", "answer": "2/7", "kps": ["kp_p6_fraction_div"], "difficulty": 0.25, "solution": "分数除以整数（0 除外）,等于乘这个整数的倒数：6/7 × 1/3 = 6/21 = 2/7。", "source": "llm_generated"},
  {"id": "p6_056", "item_type": "choice", "stem": "下面各组数中,互为倒数的一组是（　）", "options": ["A. 0.4 和 2.5", "B. 0.5 和 2.5", "C. 5 和 0.5", "D. 0.7 和 0.3"], "answer": "A", "kps": ["kp_p6_fraction_div"], "difficulty": 0.45, "solution": "乘积为 1 的两个数互为倒数：0.4×2.5=1;A 满足；B=1.25,C=2.5,D=0.21 均不为 1。", "source": "llm_generated"},
  {"id": "p6_057", "item_type": "fill", "stem": "计算：5/12 ÷ 5/6 = ____", "answer": "1/2", "kps": ["kp_p6_fraction_div"], "difficulty": 0.6, "solution": "除以一个数等于乘它的倒数：5/12 × 6/5 = 30/60 = 1/2。", "source": "llm_generated"},
  {"id": "p6_058", "item_type": "fill", "stem": "某地白天温度是 12℃,夜间温度比白天低 18℃,夜间温度是____℃。", "answer": "-6", "kps": ["kp_p6_negative_numbers"], "difficulty": 0.2, "solution": "比白天低 18℃,即 12-18 = -6(℃),用负数表示比零低的相反意义的量。", "source": "llm_generated"},
  {"id": "p6_059", "item_type": "choice", "stem": "下面各数中,最接近 0 的是（　）", "options": ["A. -3", "B. -1", "C. 2", "D. 5"], "answer": "B", "kps": ["kp_p6_negative_numbers"], "difficulty": 0.4, "solution": "最接近 0 即绝对值最小;|-3|=3,|-1|=1,|2|=2,|5|=5,绝对值最小的是 -1。", "source": "llm_generated"},
  {"id": "p6_060", "item_type": "fill", "stem": "在数轴上,一个点从 -2 向右移动 5 个单位长度,到达的数是____。", "answer": "3", "kps": ["kp_p6_negative_numbers"], "difficulty": 0.55, "solution": "数轴上向右移动表示数值变大：-2+5=3。", "source": "llm_generated"},
  {"id": "p6_061", "item_type": "fill", "stem": "把 1/8 化成百分数是____。", "answer": "12.5%", "kps": ["kp_p6_percent"], "difficulty": 0.25, "solution": "分数化百分数,先把分数化成小数再化百分数：1/8 = 0.125 = 12.5%。", "source": "llm_generated"},
  {"id": "p6_062", "item_type": "choice", "stem": "下面关于百分数的说法,正确的是（　）", "options": ["A. 分母是 100 的分数都是百分数", "B. 百分数的分子一定小于 100", "C. 百分数只表示部分与整体的关系", "D. 百分数可以大于 100%"], "answer": "D", "kps": ["kp_p6_percent"], "difficulty": 0.5, "solution": "百分数表示一个数是另一个数的百分之几,可以大于 100%,如增产二成二=125%;A 错,百分数有特定含义;B 错,分子可以≥100;C 错,百分数可表示多种关系。", "source": "llm_generated"},
  {"id": "p6_063", "item_type": "fill", "stem": "在 0.37、37%、3/10、4/7 这四个数中,最大的一个是____。", "answer": "4/7", "kps": ["kp_p6_percent"], "difficulty": 0.65, "solution": "统一化为小数比较：0.37=0.37,37%=0.37,3/10=0.3,4/7≈0.571;最大的是 4/7。", "source": "llm_generated"},
  {"id": "p6_064", "item_type": "fill", "stem": "一根绳子长 24 米,剪去它的 1/3,剪去了____米。", "answer": "8", "kps": ["kp_p6_fraction_problem"], "difficulty": 0.2, "solution": "求一个数的几分之几用乘法：24 × 1/3 = 8(米)。", "source": "llm_generated"},
  {"id": "p6_065", "item_type": "choice", "stem": "甲数是 30,乙数比甲数少 1/5,下面数量关系正确的是（　）", "options": ["A. 甲数 × (1 + 1/5) = 乙数", "B. 乙数 × (1 + 1/5) = 甲数", "C. 甲数 × (1 - 1/5) = 乙数", "D. 乙数 × (1 - 1/5) = 甲数"], "answer": "C", "kps": ["kp_p6_fraction_problem"], "difficulty": 0.45, "solution": "把甲数看作单位\"1\",乙数比甲数少 1/5,乙数就是甲数的 (1-1/5),所以甲数 × (1-1/5) = 乙数。", "source": "llm_generated"},
  {"id": "p6_066", "item_type": "fill", "stem": "商店运来一批水果,第一天卖出 2/5,第二天卖出 30 千克,刚好卖完。这批水果共有____千克。", "answer": "50", "kps": ["kp_p6_fraction_problem"], "difficulty": 0.65, "solution": "设共 x 千克,第一天 2x/5,第二天 30 千克,刚好卖完：2x/5 + 30 = x,解得 3x/5 = 30,x = 50。", "source": "llm_generated"},
  {"id": "p6_067", "item_type": "fill", "stem": "求比值：0.8:1.2 = ____（填最简分数）。", "answer": "2/3", "kps": ["kp_p6_ratio"], "difficulty": 0.2, "solution": "求比值就是前项除以后项：0.8 ÷ 1.2 = 8/12 = 2/3。", "source": "llm_generated"},
  {"id": "p6_068", "item_type": "choice", "stem": "甲数是乙数的 3 倍,甲数与乙数的比是（　）", "options": ["A. 3:1", "B. 1:3", "C. 3:0", "D. 1:4"], "answer": "A", "kps": ["kp_p6_ratio"], "difficulty": 0.45, "solution": "甲数是乙数的 3 倍,设乙数=1,则甲数=3,甲:乙 = 3:1;B 颠倒了;C 后项不能为 0,D 数值错。", "source": "llm_generated"},
  {"id": "p6_069", "item_type": "fill", "stem": "一个长方形的长是 12 厘米,宽是 8 厘米,长与宽的比是____（填最简整数比）。", "answer": "3:2", "kps": ["kp_p6_ratio"], "difficulty": 0.55, "solution": "长:宽 = 12:8,前后项同除以最大公因数 4 得 3:2。", "source": "llm_generated"},
  {"id": "p6_070", "item_type": "fill", "stem": "把 60 本书按 2:3 分给甲、乙两个班,甲班分得____本。", "answer": "24", "kps": ["kp_p6_ratio_distribution"], "difficulty": 0.2, "solution": "总份数 2+3=5,每份 60÷5=12 本,甲班 2 份即 12×2=24(本)。", "source": "llm_generated"},
  {"id": "p6_071", "item_type": "choice", "stem": "一种混凝土由水泥、沙子和石子按 1:2:3 配成,要配制 24 吨这种混凝土,需要水泥（　）吨。", "options": ["A. 4", "B. 8", "C. 12", "D. 24"], "answer": "A", "kps": ["kp_p6_ratio_distribution"], "difficulty": 0.45, "solution": "总份数 1+2+3=6,每份 24÷6=4 吨,水泥占 1 份即 4 吨。", "source": "llm_generated"},
  {"id": "p6_072", "item_type": "fill", "stem": "学校把 360 本图书按 2:3:4 分给六年级一、二、三班,三班分得图书____本。", "answer": "160", "kps": ["kp_p6_ratio_distribution"], "difficulty": 0.6, "solution": "总份数 2+3+4=9,每份 360÷9=40 本,三班 4 份即 40×4=160(本)。", "source": "llm_generated"},
  {"id": "p6_073", "item_type": "fill", "stem": "一件商品打七折后售价是 140 元,原价是____元。", "answer": "200", "kps": ["kp_p6_percent_application"], "difficulty": 0.25, "solution": "七折即按原价的 70% 出售,原价 × 70% = 140,原价 = 140 ÷ 70% = 200(元)。", "source": "llm_generated"},
  {"id": "p6_074", "item_type": "choice", "stem": "爸爸把 10000 元存入银行,定期 1 年,年利率 1.5%,到期后可得利息（　）元。", "options": ["A. 15", "B. 150", "C. 1500", "D. 15000"], "answer": "B", "kps": ["kp_p6_percent_application"], "difficulty": 0.45, "solution": "利息 = 本金 × 利率 × 存期 = 10000 × 1.5% × 1 = 150(元)。", "source": "llm_generated"},
  {"id": "p6_075", "item_type": "fill", "stem": "某商品先提价 10% 后,再降价 10%,现在售价是 99 元,原价是____元。", "answer": "100", "kps": ["kp_p6_percent_application"], "difficulty": 0.65, "solution": "设原价 x 元,提价后 x×1.1,再降价 × 0.9 = 99,即 x×0.99 = 99,x = 100。", "source": "llm_generated"},
  {"id": "p6_076", "item_type": "fill", "stem": "解比例：x/6 = 2/3,x = ____。", "answer": "4", "kps": ["kp_p6_proportion"], "difficulty": 0.2, "solution": "依据比例的基本性质（内项积=外项积）：3x = 6×2 = 12,x = 4。", "source": "llm_generated"},
  {"id": "p6_077", "item_type": "choice", "stem": "一幅地图的比例尺是 1:300000,图上距离 4 厘米,实际距离是（　）千米。", "options": ["A. 1.2", "B. 12", "C. 120", "D. 1200"], "answer": "B", "kps": ["kp_p6_proportion"], "difficulty": 0.45, "solution": "实际距离 = 图上距离 × 比例尺分母 = 4×300000 = 1200000 厘米 = 12 千米。", "source": "llm_generated"},
  {"id": "p6_078", "item_type": "fill", "stem": "解比例：1.5/x = 3/8,x = ____。", "answer": "4", "kps": ["kp_p6_proportion"], "difficulty": 0.6, "solution": "依据比例的基本性质：3x = 1.5×8 = 12,x = 12÷3 = 4。", "source": "llm_generated"},
  {"id": "p6_079", "item_type": "fill", "stem": "一辆汽车每小时行驶 60 千米,行驶的路程和时间成____比例。", "answer": "正", "kps": ["kp_p6_proportional"], "difficulty": 0.2, "solution": "速度一定时,路程÷时间 = 速度（常量）,两个相关联的量的比值一定,成正比例。", "source": "llm_generated"},
  {"id": "p6_080", "item_type": "choice", "stem": "下面两个量中,成正比例关系的是（　）", "options": ["A. 长方形的面积一定,它的长和宽", "B. 速度一定,行驶的路程和时间", "C. 一堆煤,每天烧的吨数和烧的天数", "D. 圆的面积和半径"], "answer": "B", "kps": ["kp_p6_proportional"], "difficulty": 0.45, "solution": "B 中速度一定,路程/时间=速度（常量）,成正比例;A 长×宽=常量是反比例;C 每天烧×天数=常量是反比例;D 面积÷半径=π×半径(变化),不成正比例。", "source": "llm_generated"},
  {"id": "p6_081", "item_type": "fill", "stem": "小明 3 分钟走了 240 步。照这样的速度,5 分钟能走____步。", "answer": "400", "kps": ["kp_p6_proportional"], "difficulty": 0.6, "solution": "速度一定,路程与时间成正比例：每分钟 240÷3=80 步,5 分钟 80×5=400(步)。", "source": "llm_generated"},
  {"id": "p6_082", "item_type": "fill", "stem": "以学校为观测点,图书馆在学校北偏东 30° 方向上。反过来,以图书馆为观测点,学校在图书馆的____方向上。", "answer": "南偏西30°", "kps": ["kp_p6_position_direction"], "difficulty": 0.25, "solution": "观测点互换时方向相反：北偏东 30° 的相反方向是南偏西 30°,角度不变。", "source": "llm_generated"},
  {"id": "p6_083", "item_type": "choice", "stem": "小亮从家出发,先向正北走 200 米到书店,再向正东走 200 米到学校。下面关于学校相对家的方向,正确的是（　）", "options": ["A. 学校在家的北偏东方向", "B. 学校在家的南偏西方向", "C. 学校在家的正北方向", "D. 学校在家的正东方向"], "answer": "A", "kps": ["kp_p6_position_direction"], "difficulty": 0.45, "solution": "学校相对家既偏北又偏东,落在北偏东方向（东北象限）;B 是反向,C、D 都只反映一个方向。", "source": "llm_generated"},
  {"id": "p6_084", "item_type": "fill", "stem": "小华从家出发,先向正东走 200 米到超市,再向正南走 100 米到学校。从学校出发回家,先向____走 100 米到超市。", "answer": "正北", "kps": ["kp_p6_position_direction"], "difficulty": 0.65, "solution": "从学校出发,要沿原来的路返回,先沿\"正南\"的反方向即\"正北\"走 100 米到超市。", "source": "llm_generated"},
  {"id": "p6_085", "item_type": "fill", "stem": "某校六年级同学最喜欢的运动项目情况用扇形统计图表示：跑步占 35%,球类占 25%,游泳占 20%,其他占 20%。喜欢球类的人数比喜欢跑步的少____个百分点。", "answer": "10", "kps": ["kp_p6_pie_chart"], "difficulty": 0.25, "solution": "扇形图各百分比反映各类人数占总体的比;喜欢跑步 35%、球类 25%,球类比跑步少 35%-25%=10 个百分点。", "source": "llm_generated"},
  {"id": "p6_086", "item_type": "choice", "stem": "下面关于扇形统计图特点的描述,正确的是（　）", "options": ["A. 扇形统计图能清楚地表示数量的多少", "B. 扇形统计图能清楚地表示各部分数量与总数的关系", "C. 扇形统计图能清楚地表示数量的增减变化", "D. 扇形统计图能清楚地表示数据的具体数值"], "answer": "B", "kps": ["kp_p6_pie_chart"], "difficulty": 0.45, "solution": "扇形统计图用扇形面积表示各部分占总体的百分比,核心是部分与整体的关系;A、C、D 是其他统计图的特点。", "source": "llm_generated"},
  {"id": "p6_087", "item_type": "fill", "stem": "某农场种植粮食作物 120 公顷,占总种植面积的 60%。这个农场总种植面积是____公顷。", "answer": "200", "kps": ["kp_p6_pie_chart"], "difficulty": 0.65, "solution": "总种植面积×60% = 120,总种植面积 = 120 ÷ 60% = 200(公顷)。", "source": "llm_generated"},
  {"id": "p6_088", "item_type": "fill", "stem": "算式 1+3+5+7+9+11+13 = ____。", "answer": "49", "kps": ["kp_p6_number_shape"], "difficulty": 0.2, "solution": "从 1 开始的连续 n 个奇数的和 = n²;n=7 时和为 7² = 49。", "source": "llm_generated"},
  {"id": "p6_089", "item_type": "choice", "stem": "观察下面由三角形组成的'三角形数'序列：1, 3, 6, 10, 15, …。第 8 个三角形数是（　）", "options": ["A. 21", "B. 28", "C. 36", "D. 45"], "answer": "C", "kps": ["kp_p6_number_shape"], "difficulty": 0.45, "solution": "三角形数第 n 项为 n(n+1)/2;第 8 项 = 8×9÷2 = 36。", "source": "llm_generated"},
  {"id": "p6_090", "item_type": "fill", "stem": "观察数列：1, 9, 25, 49, ____。横线上的数是____。", "answer": "81", "kps": ["kp_p6_number_shape"], "difficulty": 0.6, "solution": "数列各项为连续奇数的平方：1²=1,3²=9,5²=25,7²=49,9²=81;下一项为 9²=81。", "source": "llm_generated"}
]