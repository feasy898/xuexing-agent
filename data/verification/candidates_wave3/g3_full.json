[
  {"id": "p3_048", "item_type": "fill", "stem": "秒针从数字3走到数字6,一共走了____秒。", "answer": "15", "kps": ["kp_p3_time_read"], "difficulty": 0.2, "solution": "秒针走1大格是5秒,从3走到6共走了3大格,3×5=15秒。", "source": "llm_generated"},
  {"id": "p3_049", "item_type": "choice", "stem": "小红早上7时55分到校,第一节课8时10分开始,她还要等____才能上课。", "options": ["A. 10分钟", "B. 15分钟", "C. 20分钟", "D. 25分钟"], "answer": "B", "kps": ["kp_p3_time_read"], "difficulty": 0.45, "solution": "8时10分-7时55分:55分到10分差15分钟,所以她还要等15分钟才能上课。", "source": "llm_generated"},
  {"id": "p3_050", "item_type": "fill", "stem": "一场电影14:30开始,16:05结束,中间播放影片的时间是____分钟。", "answer": "95", "kps": ["kp_p3_time_read"], "difficulty": 0.65, "solution": "14:30到16:00是90分钟,16:00到16:05再加5分钟,合计90+5=95分钟。", "source": "llm_generated"},
  {"id": "p3_051", "item_type": "choice", "stem": "一支新铅笔大约长18____。", "options": ["A. 毫米", "B. 厘米", "C. 分米", "D. 米"], "answer": "B", "kps": ["kp_p3_measure_units"], "difficulty": 0.2, "solution": "一支新铅笔大约长18厘米最合适,毫米太短,分米和米又太长。", "source": "llm_generated"},
  {"id": "p3_052", "item_type": "fill", "stem": "1米3分米=____分米。", "answer": "13", "kps": ["kp_p3_measure_units"], "difficulty": 0.4, "solution": "1米=10分米,10+3=13分米。", "source": "llm_generated"},
  {"id": "p3_053", "item_type": "choice", "stem": "把4千米、4500米、4千米50米、4400米按从大到小排列,排在第二位的是( )。", "options": ["A. 4千米", "B. 4500米", "C. 4千米50米", "D. 4400米"], "answer": "D", "kps": ["kp_p3_measure_units"], "difficulty": 0.6, "solution": "统一单位:4千米=4000米,4千米50米=4050米。从大到小依次是4500米、4400米、4050米、4000米,排在第二位的是4400米。", "source": "llm_generated"},
  {"id": "p3_054", "item_type": "fill", "stem": "一个数比456大128,这个数是____。", "answer": "584", "kps": ["kp_p3_addsub_3digit"], "difficulty": 0.25, "solution": "比456大128,求这个数用加法:456+128=584。", "source": "llm_generated"},
  {"id": "p3_055", "item_type": "choice", "stem": "小华在书店买一本《故事大王》付了50元,找回14元,这本书的价钱是( )。", "options": ["A. 36元", "B. 46元", "C. 64元", "D. 26元"], "answer": "A", "kps": ["kp_p3_addsub_3digit"], "difficulty": 0.55, "solution": "书的价钱=付出-找回=50-14=36元。", "source": "llm_generated"},
  {"id": "p3_056", "item_type": "fill", "stem": "果园里有梨树24棵,苹果树的棵数是梨树的2倍,苹果树有____棵。", "answer": "48", "kps": ["kp_p3_multiple_times"], "difficulty": 0.35, "solution": "求一个数的几倍用乘法:苹果树=24×2=48棵。", "source": "llm_generated"},
  {"id": "p3_057", "item_type": "choice", "stem": "饲养小组养了白兔8只,黑兔的只数是白兔的3倍,灰兔的只数是白兔的4倍。三种兔子一共有( )只。", "options": ["A. 48", "B. 56", "C. 64", "D. 24"], "answer": "C", "kps": ["kp_p3_multiple_times"], "difficulty": 0.6, "solution": "黑兔8×3=24只,灰兔8×4=32只,合计白兔+黑兔+灰兔=8+24+32=64只。", "source": "llm_generated"},
  {"id": "p3_058", "item_type": "fill", "stem": "600×5=____", "answer": "3000", "kps": ["kp_p3_mult_1digit"], "difficulty": 0.2, "solution": "整百数乘一位数:先算6×5=30,再在末尾添上2个0,得3000。", "source": "llm_generated"},
  {"id": "p3_059", "item_type": "choice", "stem": "计算132×4,正确的结果是( )。", "options": ["A. 428", "B. 528", "C. 538", "D. 418"], "answer": "B", "kps": ["kp_p3_mult_1digit"], "difficulty": 0.4, "solution": "132×4:个位2×4=8,十位3×4=12写2进1,百位1×4+1=5,得528。", "source": "llm_generated"},
  {"id": "p3_060", "item_type": "fill", "stem": "学校买了4箱羽毛球,每箱24筒,一共有____筒。", "answer": "96", "kps": ["kp_p3_mult_1digit"], "difficulty": 0.65, "solution": "求几个相同加数的和用乘法:24×4=96筒。", "source": "llm_generated"},
  {"id": "p3_061", "item_type": "fill", "stem": "一个长方形长7厘米、宽3厘米,它的周长是____厘米。", "answer": "20", "kps": ["kp_p3_perimeter"], "difficulty": 0.25, "solution": "长方形周长=(长+宽)×2=(7+3)×2=20厘米。", "source": "llm_generated"},
  {"id": "p3_062", "item_type": "choice", "stem": "用一根铁丝围成一个边长8厘米的正方形,如果把这根铁丝改围成一个长10厘米的长方形,长方形的宽是( )厘米。", "options": ["A. 4", "B. 6", "C. 8", "D. 10"], "answer": "B", "kps": ["kp_p3_perimeter"], "difficulty": 0.55, "solution": "铁丝长=正方形周长=8×4=32厘米;改围成长方形后,长方形周长也是32厘米,宽=(32-10×2)÷2=6厘米。", "source": "llm_generated"},
  {"id": "p3_063", "item_type": "choice", "stem": "下面各图中,阴影部分能用1/3表示的是( )。", "options": ["A. 圆平均分成2份涂1份", "B. 长方形平均分成3份涂1份", "C. 正方形平均分成4份涂2份", "D. 三角形平均分成3份涂2份"], "answer": "B", "kps": ["kp_p3_fraction_intro"], "difficulty": 0.3, "solution": "把一个图形平均分成几份,涂其中的1份就是几分之一。平均分成3份涂1份就是1/3;A是1/2,C是1/2,D是2/3。", "source": "llm_generated"},
  {"id": "p3_064", "item_type": "fill", "stem": "1可以看作分母是5的分数,即1=____/5。", "answer": "5", "kps": ["kp_p3_fraction_intro"], "difficulty": 0.5, "solution": "分子与分母相同(且不为0)的分数等于1,即5/5=1,所以1=5/5。", "source": "llm_generated"},
  {"id": "p3_065", "item_type": "choice", "stem": "计算84÷4,正确的结果是( )。", "options": ["A. 21", "B. 24", "C. 26", "D. 211"], "answer": "A", "kps": ["kp_p3_div_1digit"], "difficulty": 0.3, "solution": "84÷4:十位8÷4商2,个位4÷4商1,得21。验算21×4=84。", "source": "llm_generated"},
  {"id": "p3_066", "item_type": "fill", "stem": "有69个苹果,平均分给3个小朋友,每个小朋友分____个。", "answer": "23", "kps": ["kp_p3_div_1digit"], "difficulty": 0.55, "solution": "平均分用除法:69÷3=23,验算23×3=69,每个小朋友分23个。", "source": "llm_generated"},
  {"id": "p3_067", "item_type": "fill", "stem": "11×11=____", "answer": "121", "kps": ["kp_p3_mult_2x2digit"], "difficulty": 0.25, "solution": "11×11:十位1×1=1,十位交叉乘1×1+1×1=2,个位1×1=1,得121。", "source": "llm_generated"},
  {"id": "p3_068", "item_type": "choice", "stem": "计算23×12,正确的结果是( )。", "options": ["A. 246", "B. 256", "C. 276", "D. 286"], "answer": "C", "kps": ["kp_p3_mult_2x2digit"], "difficulty": 0.5, "solution": "23×12=23×10+23×2=230+46=276。", "source": "llm_generated"},
  {"id": "p3_069", "item_type": "fill", "stem": "估算:49×21的结果大约是____。", "answer": "1000", "kps": ["kp_p3_mult_2x2digit"], "difficulty": 0.7, "solution": "估算时把49看作50,21看作20,50×20=1000,所以49×21≈1000。", "source": "llm_generated"},
  {"id": "p3_070", "item_type": "fill", "stem": "边长1分米的正方形,面积是1____(填单位)。", "answer": "平方分米", "kps": ["kp_p3_area"], "difficulty": 0.2, "solution": "边长1分米的正方形,面积就是1平方分米。", "source": "llm_generated"},
  {"id": "p3_071", "item_type": "choice", "stem": "用12个边长1厘米的小正方形拼成长方形(不重叠),下列哪组拼法周长最短?( )", "options": ["A. 长12厘米宽1厘米", "B. 长6厘米宽2厘米", "C. 长4厘米宽3厘米", "D. 三种周长都一样"], "answer": "C", "kps": ["kp_p3_area"], "difficulty": 0.45, "solution": "三种拼法面积都是12平方厘米,周长分别26厘米、16厘米、14厘米,所以4×3的拼法周长最短。", "source": "llm_generated"},
  {"id": "p3_072", "item_type": "fill", "stem": "一根铁丝可以围成一个长10厘米宽6厘米的长方形,如果把它改围成一个正方形,正方形的面积是____平方厘米。", "answer": "64", "kps": ["kp_p3_area"], "difficulty": 0.7, "solution": "铁丝长=(10+6)×2=32厘米,改围正方形边长=32÷4=8厘米,面积=8×8=64平方厘米。", "source": "llm_generated"},
  {"id": "p3_073", "item_type": "fill", "stem": "平年的2月有____天。", "answer": "28", "kps": ["kp_p3_ymd_date"], "difficulty": 0.25, "solution": "平年2月有28天,闰年2月才有29天。", "source": "llm_generated"},
  {"id": "p3_074", "item_type": "choice", "stem": "下面公历年份中,是闰年的是( )。", "options": ["A. 2018年", "B. 2019年", "C. 2020年", "D. 2021年"], "answer": "C", "kps": ["kp_p3_ymd_date"], "difficulty": 0.5, "solution": "公历年份是4的倍数通常是闰年(整百年要能被400整除才是闰年),2020÷4=505,2020年是闰年。", "source": "llm_generated"},
  {"id": "p3_075", "item_type": "fill", "stem": "某商店营业时间是9:00~21:30,一天营业____小时____分钟。", "answer": "12、30", "kps": ["kp_p3_ymd_date"], "difficulty": 0.7, "solution": "21时30分-9时=12时30分,所以一天营业12小时30分钟。", "source": "llm_generated"},
  {"id": "p3_076", "item_type": "choice", "stem": "下面四个小数中,最接近1的是( )。", "options": ["A. 0.5", "B. 1.2", "C. 0.7", "D. 1.4"], "answer": "B", "kps": ["kp_p3_decimal_intro"], "difficulty": 0.25, "solution": "分别算与1的差:1-0.5=0.5,1.2-1=0.2,1-0.7=0.3,1.4-1=0.4,1.2差0.2最小,最接近1。", "source": "llm_generated"},
  {"id": "p3_077", "item_type": "fill", "stem": "4.5元+2.8元=____元", "answer": "7.3", "kps": ["kp_p3_decimal_intro"], "difficulty": 0.45, "solution": "一位小数相加:4.5+2.8,按相同数位对齐相加,得7.3元。", "source": "llm_generated"},
  {"id": "p3_078", "item_type": "choice", "stem": "小红买一本笔记本3.5元、一块橡皮0.8元,付出10元,应找回( )。", "options": ["A. 5.7元", "B. 6.3元", "C. 6.7元", "D. 4.3元"], "answer": "A", "kps": ["kp_p3_decimal_intro"], "difficulty": 0.7, "solution": "共花3.5+0.8=4.3元,找回10-4.3=5.7元。", "source": "llm_generated"},
  {"id": "p3_079", "item_type": "choice", "stem": "根据复式统计表:三(1)班喜欢唱歌的男生15人、女生18人,喜欢跳舞的男生12人、女生14人。喜欢唱歌的比喜欢跳舞的一共多( )人。", "options": ["A. 3", "B. 7", "C. 33", "D. 26"], "answer": "B", "kps": ["kp_p3_stats_table"], "difficulty": 0.3, "solution": "喜欢唱歌15+18=33人,喜欢跳舞12+14=26人,33-26=7人,喜欢唱歌的比喜欢跳舞的多7人。", "source": "llm_generated"},
  {"id": "p3_080", "item_type": "fill", "stem": "三(2)班图书角统计:故事书25本、科技书18本、连环画12本。三类书共有____本。", "answer": "55", "kps": ["kp_p3_stats_table"], "difficulty": 0.55, "solution": "三类书合计25+18+12=55本。", "source": "llm_generated"},
  {"id": "p3_081", "item_type": "choice", "stem": "根据复式统计表:喜欢篮球的男生18人、女生12人;喜欢足球的男生22人、女生8人。下面说法正确的是( )。", "options": ["A. 喜欢篮球的男生比女生多6人", "B. 喜欢足球的男生比女生多14人", "C. 喜欢篮球的女生比喜欢足球的女生多4人", "D. A、B、C都对"], "answer": "D", "kps": ["kp_p3_stats_table"], "difficulty": 0.75, "solution": "A:18-12=6,正确;B:22-8=14,正确;C:12-8=4,正确。A、B、C都对,选D。", "source": "llm_generated"},
  {"id": "p3_082", "item_type": "fill", "stem": "小华早餐有2种主食(馒头、米饭)和3种饮料(牛奶、豆浆、果汁),一共有____种不同的搭配。", "answer": "6", "kps": ["kp_p3_combination"], "difficulty": 0.25, "solution": "每种主食可以配3种饮料,2种主食就有2×3=6种不同的搭配。", "source": "llm_generated"},
  {"id": "p3_083", "item_type": "choice", "stem": "用数字1、3、5、7组成十位与个位不同且数字不重复的两位数,一共能组成( )个。", "options": ["A. 4", "B. 8", "C. 12", "D. 16"], "answer": "C", "kps": ["kp_p3_combination"], "difficulty": 0.5, "solution": "十位有4种选法,个位有3种选法(不能与十位重复),一共能组成4×3=12个不重复的两位数。", "source": "llm_generated"},
  {"id": "p3_084", "item_type": "fill", "stem": "从3名男生和2名女生中各选1人组成一组参加比赛,一共有____种不同的选法。", "answer": "6", "kps": ["kp_p3_combination"], "difficulty": 0.7, "solution": "3名男生任选1人有3种选法,2名女生任选1人有2种选法,组合起来有3×2=6种选法。", "source": "llm_generated"}
