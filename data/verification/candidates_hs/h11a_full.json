[
  {"id": "h_h11a_001", "item_type": "choice", "stem": "下列各量中，是向量的为（　）", "options": ["A. 时间", "B. 长度", "C. 速度", "D. 质量"], "answer": "C", "kps": ["kp_h11_vec_concept"], "difficulty": 0.2, "solution": "速度既有大小又有方向，是向量；时间、长度、质量只有大小没有方向，是标量。", "source": "llm_generated"},
  {"id": "h_h11a_002", "item_type": "fill", "stem": "规定：与任意向量都平行的向量是____向量。", "answer": "零", "kps": ["kp_h11_vec_concept"], "difficulty": 0.45, "solution": "按平面向量的概念，规定零向量与任意向量平行（共线）。", "source": "llm_generated"},
  {"id": "h_h11a_003", "item_type": "choice", "stem": "下列说法中，正确的是（　）", "options": ["A. 向量AB与向量BA相等", "B. 任意两个单位向量都相等", "C. 若向量a与b共线，则a与b方向相同", "D. 零向量的模为0"], "answer": "D", "kps": ["kp_h11_vec_concept"], "difficulty": 0.7, "solution": "A错，AB与BA方向相反；B错，单位向量模都为1但方向可不同；C错，共线包括方向相反的情形（且零向量与任意向量共线）；D正确，零向量的模为0。", "source": "llm_generated"},
  {"id": "h_h11a_004", "item_type": "choice", "stem": "在下列向量运算中，AB+BC=（　）", "options": ["A. AC", "B. CA", "C. 0", "D. AB+CB"], "answer": "A", "kps": ["kp_h11_vec_addsub"], "difficulty": 0.2, "solution": "由向量加法的三角形法则，首尾相接：AB+BC=AC。", "source": "llm_generated"},
  {"id": "h_h11a_005", "item_type": "fill", "stem": "若a与b互为相反向量，则a+b=____。", "answer": "0", "kps": ["kp_h11_vec_addsub"], "difficulty": 0.45, "solution": "相反向量是大小相等、方向相反的向量，b=-a，故a+b=0。", "source": "llm_generated"},
  {"id": "h_h11a_006", "item_type": "choice", "stem": "已知非零向量a、b满足|a+b|=|a-b|，则a与b的位置关系是（　）", "options": ["A. a∥b", "B. a⊥b", "C. a=b", "D. a=0"], "answer": "B", "kps": ["kp_h11_vec_addsub"], "difficulty": 0.7, "solution": "|a+b|=|a-b|两边平方：|a|²+2a·b+|b|²=|a|²-2a·b+|b|²，得4a·b=0，即a·b=0，所以a⊥b。", "source": "llm_generated"},
  {"id": "h_h11a_007", "item_type": "choice", "stem": "已知a≠0，则λa=0当且仅当（　）", "options": ["A. λ=0", "B. a=0", "C. λ>0", "D. λ<0"], "answer": "A", "kps": ["kp_h11_vec_scalar"], "difficulty": 0.2, "solution": "由向量数乘的定义，a≠0时，|λa|=|λ|·|a|，故λa=0当且仅当λ=0。", "source": "llm_generated"},
  {"id": "h_h11a_008", "item_type": "fill", "stem": "已知a≠0，b∥a当且仅当存在唯一实数____使b=λa。", "answer": "λ", "kps": ["kp_h11_vec_scalar"], "difficulty": 0.45, "solution": "向量共线定理：a≠0时，b∥a当且仅当存在唯一实数λ使b=λa。", "source": "llm_generated"},
  {"id": "h_h11a_009", "item_type": "choice", "stem": "已知向量a、b不共线，且λa+μb=0，则（　）", "options": ["A. λ=μ=0", "B. λ≠0且μ≠0", "C. λ、μ不全为零", "D. λ>0，μ<0"], "answer": "A", "kps": ["kp_h11_vec_scalar"], "difficulty": 0.7, "solution": "若a、b不共线，则它们线性无关，由线性无关的定义，λa+μb=0当且仅当λ=μ=0。", "source": "llm_generated"},
  {"id": "h_h11a_010", "item_type": "choice", "stem": "平面向量基本定理中，作为基底的两个向量应满足（　）", "options": ["A. 平行且不相等", "B. 不平行（不共线）", "C. 相等", "D. 模相等"], "answer": "B", "kps": ["kp_h11_vec_basic_theorem"], "difficulty": 0.2, "solution": "平面向量基本定理要求基底中的两个向量不共线（不平行）。", "source": "llm_generated"},
  {"id": "h_h11a_011", "item_type": "fill", "stem": "已知e₁、e₂是同一平面内不共线的两个向量，若a=3e₁-2e₂，则a关于基底{e₁,e₂}的坐标为____。", "answer": "(3,-2)", "kps": ["kp_h11_vec_basic_theorem"], "difficulty": 0.5, "solution": "按平面向量基本定理，向量a=λ₁e₁+λ₂e₂的唯一表示中，a关于基底{e₁,e₂}的坐标为(λ₁,λ₂)=(3,-2)。", "source": "llm_generated"},
  {"id": "h_h11a_012", "item_type": "choice", "stem": "在△ABC中，点D在边BC上且BD:DC=1:2，则AD=（　）", "options": ["A. (1/3)AB+(2/3)AC", "B. (2/3)AB+(1/3)AC", "C. (1/3)AB+(1/3)AC", "D. AB+AC"], "answer": "B", "kps": ["kp_h11_vec_basic_theorem"], "difficulty": 0.7, "solution": "BD:DC=1:2则BD=(1/3)BC，AD=AB+BD=AB+(1/3)(AC-AB)=(2/3)AB+(1/3)AC。", "source": "llm_generated"},
  {"id": "h_h11a_013", "item_type": "choice", "stem": "已知A(1,3)、B(4,5)，则AB=（　）", "options": ["A. (3,2)", "B. (-3,-2)", "C. (5,8)", "D. (3,-2)"], "answer": "A", "kps": ["kp_h11_vec_coords"], "difficulty": 0.2, "solution": "由坐标公式，AB=(4-1,5-3)=(3,2)。", "source": "llm_generated"},
  {"id": "h_h11a_014", "item_type": "fill", "stem": "已知A(-1,2)、B(3,-4)、C(2,1)，则AB+AC=____。", "answer": "(7,-7)", "kps": ["kp_h11_vec_coords"], "difficulty": 0.45, "solution": "AB=(4,-6)，AC=(3,-1)，AB+AC=(7,-7)。", "source": "llm_generated"},
  {"id": "h_h11a_015", "item_type": "choice", "stem": "已知向量a=(1,2)，b=(x,1)，且a∥b，则x=（　）", "options": ["A. -2", "B. -1/2", "C. 1/2", "D. 2"], "answer": "C", "kps": ["kp_h11_vec_coords"], "difficulty": 0.7, "solution": "a∥b等价于1·1-2·x=0，解得x=1/2。", "source": "llm_generated"},
  {"id": "h_h11a_016", "item_type": "choice", "stem": "平面向量a、b的夹角θ的取值范围是（　）", "options": ["A. (0,π)", "B. [0,π]", "C. (0,π/2]", "D. [0,π/2]"], "answer": "B", "kps": ["kp_h11_vec_dot_product"], "difficulty": 0.2, "solution": "两非零向量夹角θ的取值范围是[0,π]。", "source": "llm_generated"},
  {"id": "h_h11a_017", "item_type": "fill", "stem": "已知|a|=3，|b|=4，a·b=-6，则a与b的夹角θ为____。", "answer": "2π/3", "kps": ["kp_h11_vec_dot_product"], "difficulty": 0.5, "solution": "cosθ=a·b/(|a||b|)=-6/(3×4)=-1/2，θ∈[0,π]，故θ=2π/3。", "source": "llm_generated"},
  {"id": "h_h11a_018", "item_type": "choice", "stem": "已知|a|=1，|b|=2，a·b=-1，则a与b的夹角为（　）", "options": ["A. 30°", "B. 60°", "C. 120°", "D. 150°"], "answer": "C", "kps": ["kp_h11_vec_dot_product"], "difficulty": 0.7, "solution": "cosθ=a·b/(|a||b|)=-1/(1×2)=-1/2，θ∈[0,π]，故θ=120°。", "source": "llm_generated"},
  {"id": "h_h11a_019", "item_type": "choice", "stem": "已知a=(-1,2)，b=(2,-4)，则a·b=（　）", "options": ["A. 0", "B. -8", "C. -10", "D. -6"], "answer": "C", "kps": ["kp_h11_vec_dot_coords"], "difficulty": 0.2, "solution": "由数量积的坐标公式，a·b=(-1)×2+2×(-4)=-2-8=-10。", "source": "llm_generated"},
  {"id": "h_h11a_020", "item_type": "fill", "stem": "已知a=(3,-4)，则|a|=____。", "answer": "5", "kps": ["kp_h11_vec_dot_coords"], "difficulty": 0.45, "solution": "|a|=√(3²+(-4)²)=√25=5。", "source": "llm_generated"},
  {"id": "h_h11a_021", "item_type": "choice", "stem": "已知A(1,2)、B(3,4)、C(-1,4)，则△ABC中∠A=（　）", "options": ["A. 30°", "B. 60°", "C. 90°", "D. 120°"], "answer": "C", "kps": ["kp_h11_vec_dot_coords"], "difficulty": 0.7, "solution": "AB=(2,2)，AC=(-2,2)，AB·AC=-4+4=0，所以∠A=90°。", "source": "llm_generated"},
  {"id": "h_h11a_022", "item_type": "fill", "stem": "在△ABC中，a²=b²+c²-2bccosA是____定理的内容。", "answer": "余弦", "kps": ["kp_h11_law_of_cosines"], "difficulty": 0.2, "solution": "这是余弦定理的标准形式，反映三角形中边与角的关系。", "source": "llm_generated"},
  {"id": "h_h11a_023", "item_type": "fill", "stem": "在△ABC中，若a=3、b=4、C=60°，则c=____。", "answer": "√13", "kps": ["kp_h11_law_of_cosines"], "difficulty": 0.45, "solution": "由余弦定理，c²=a²+b²-2abcosC=9+16-24×(1/2)=13，故c=√13。", "source": "llm_generated"},
  {"id": "h_h11a_024", "item_type": "choice", "stem": "在△ABC中，若a=7、b=5、c=3，则cosA=（　）", "options": ["A. 1/5", "B. -1/5", "C. 1/7", "D. -1/7"], "answer": "B", "kps": ["kp_h11_law_of_cosines"], "difficulty": 0.7, "solution": "由余弦定理推论，cosA=(b²+c²-a²)/(2bc)=(25+9-49)/(30)=-15/30=-1/5。", "source": "llm_generated"},
  {"id": "h_h11a_025", "item_type": "fill", "stem": "正弦定理：a/sinA=b/sinB=c/sinC=____（其中R为三角形外接圆半径）。", "answer": "2R", "kps": ["kp_h11_law_of_sines"], "difficulty": 0.2, "solution": "正弦定理表明三角形各边与对应角正弦的比相等，等于外接圆直径2R。", "source": "llm_generated"},
  {"id": "h_h11a_026", "item_type": "choice", "stem": "在△ABC中，若A=30°、B=45°、a=2，则b=（　）", "options": ["A. 2√2", "B. 2√3", "C. 4", "D. √2"], "answer": "A", "kps": ["kp_h11_law_of_sines"], "difficulty": 0.5, "solution": "由正弦定理，b=asinB/sinA=2×sin45°/sin30°=2×(√2/2)/(1/2)=2√2。", "source": "llm_generated"},
  {"id": "h_h11a_027", "item_type": "choice", "stem": "在△ABC中，若a=5、b=7、A=30°，则满足条件的三角形（　）", "options": ["A. 有一个", "B. 有两个", "C. 不存在", "D. 不能确定"], "answer": "B", "kps": ["kp_h11_law_of_sines"], "difficulty": 0.7, "solution": "由正弦定理sinB=bsinA/a=7×sin30°/5=7/10=0.7。因a<b，且a>bsinA=3.5，所以B有两解（一个锐角一个钝角），三角形有两个。", "source": "llm_generated"},
  {"id": "h_h11a_028", "item_type": "choice", "stem": "三角形面积公式S=(1/2)absinC中，sinC是角C的（　）", "options": ["A. 对边比斜边", "B. 邻边比斜边", "C. 正弦值", "D. 余弦值"], "answer": "C", "kps": ["kp_h11_triangle_solve"], "difficulty": 0.2, "solution": "sinC是角C的正弦值。", "source": "llm_generated"},
  {"id": "h_h11a_029", "item_type": "fill", "stem": "在△ABC中，若a=2、B=30°、C=45°，则A=____，b=____。", "answer": "A=105°，b=√6-√2", "kps": ["kp_h11_triangle_solve"], "difficulty": 0.5, "solution": "A=180°-B-C=180°-30°-45°=105°；b=asinB/sinA=2×sin30°/sin105°=1/sin105°=4/(√6+√2)=√6-√2。", "source": "llm_generated"},
  {"id": "h_h11a_030", "item_type": "solve", "stem": "在某山顶测得山脚P的俯角为30°，沿水平方向前进100米到达Q点，再测得P的俯角为60°。设山高为h米，求h的值。", "answer": "h=50√3米", "kps": ["kp_h11_triangle_solve"], "difficulty": 0.7, "solution": "设山顶为A，山脚为P。第一次观测位置在山顶正对面水平距离d₁处，tan30°=h/d₁，得d₁=h√3；第二次位置比第一次近山脚100米，水平距离d₂=d₁-100，tan60°=h/d₂，得d₂=h/√3。故d₁-d₂=100，即h√3-h/√3=100，化简得2h/√3=100，h=50√3米。", "source": "llm_generated"},
  {"id": "h_h11a_031", "item_type": "choice", "stem": "复数z=a+bi（a,b∈R）为纯虚数的充要条件是（　）", "options": ["A. a=0", "B. b=0", "C. a=0且b≠0", "D. b≠0"], "answer": "C", "kps": ["kp_h11_complex_concept"], "difficulty": 0.2, "solution": "纯虚数要求实部为0且虚部不为0，即a=0且b≠0。", "source": "llm_generated"},
  {"id": "h_h11a_032", "item_type": "fill", "stem": "i²+i³+i⁴=____（用最简形式表示）。", "answer": "-i", "kps": ["kp_h11_complex_concept"], "difficulty": 0.45, "solution": "i²=-1，i³=i²·i=-i，i⁴=(i²)²=1，故i²+i³+i⁴=-1-i+1=-i。", "source": "llm_generated"},
  {"id": "h_h11a_033", "item_type": "choice", "stem": "已知x,y∈R，复数z₁=x+3i，z₂=5+yi，若z₁=z₂，则x+y=（　）", "options": ["A. 8", "B. 2", "C. -2", "D. 5"], "answer": "A", "kps": ["kp_h11_complex_concept"], "difficulty": 0.7, "solution": "两个复数相等当且仅当实部与虚部分别相等：x=5且3=y，故x+y=5+3=8。", "source": "llm_generated"},
  {"id": "h_h11a_034", "item_type": "choice", "stem": "复数z=3-4i在复平面内对应的点位于（　）", "options": ["A. 第一象限", "B. 第二象限", "C. 第三象限", "D. 第四象限"], "answer": "D", "kps": ["kp_h11_complex_plane"], "difficulty": 0.2, "solution": "z=3-4i对应复平面上的点(3,-4)，位于第四象限。", "source": "llm_generated"},
  {"id": "h_h11a_035", "item_type": "fill", "stem": "复数z=1+i的模|z|=____。", "answer": "√2", "kps": ["kp_h11_complex_plane"], "difficulty": 0.45, "solution": "|z|=√(1²+1²)=√2。", "source": "llm_generated"},
  {"id": "h_h11a_036", "item_type": "choice", "stem": "已知复数z=1+i，则z̄+|z|=（　）", "options": ["A. (1+√2)+i", "B. (1+√2)-i", "C. 2-i", "D. 2+i"], "answer": "B", "kps": ["kp_h11_complex_plane"], "difficulty": 0.7, "solution": "z=1+i的共轭z̄=1-i，模|z|=√2，故z̄+|z|=(1+√2)-i。", "source": "llm_generated"},
  {"id": "h_h11a_037", "item_type": "fill", "stem": "(3+2i)+(1-4i)=____。", "answer": "4-2i", "kps": ["kp_h11_complex_addsub"], "difficulty": 0.2, "solution": "(3+2i)+(1-4i)=(3+1)+(2-4)i=4-2i。", "source": "llm_generated"},
  {"id": "h_h11a_038", "item_type": "choice", "stem": "已知复数z₁=1+i，z₂=2-3i，则z₁-z₂在复平面内对应的点位于（　）", "options": ["A. 第一象限", "B. 第二象限", "C. 第三象限", "D. 第四象限"], "answer": "B", "kps": ["kp_h11_complex_addsub"], "difficulty": 0.5, "solution": "z₁-z₂=(1-2)+(1-(-3))i=-1+4i，对应点(-1,4)位于第二象限。", "source": "llm_generated"},
  {"id": "h_h11a_039", "item_type": "fill", "stem": "已知(x+2i)+(3-yi)=5+i（x,y为实数），则x+y=____。", "answer": "3", "kps": ["kp_h11_complex_addsub"], "difficulty": 0.7, "solution": "(x+3)+(2-y)i=5+i。由复数相等得x+3=5、2-y=1，故x=2、y=1，x+y=3。", "source": "llm_generated"},
  {"id": "h_h11a_040", "item_type": "fill", "stem": "(1+i)(1-i)=____。", "answer": "2", "kps": ["kp_h11_complex_muldiv"], "difficulty": 0.2, "solution": "(1+i)(1-i)=1²-i²=1-(-1)=2。", "source": "llm_generated"},
  {"id": "h_h11a_041", "item_type": "choice", "stem": "复数z=(1+i)/(1-i)等于（　）", "options": ["A. i", "B. -i", "C. 1+i", "D. 1-i"], "answer": "A", "kps": ["kp_h11_complex_muldiv"], "difficulty": 0.5, "solution": "z=(1+i)/(1-i)=(1+i)²/[(1-i)(1+i)]=(1+2i+i²)/2=(1+2i-1)/2=i。", "source": "llm_generated"},
  {"id": "h_h11a_042", "item_type": "fill", "stem": "已知复数z满足z(1+i)=2，则z=____。", "answer": "1-i", "kps": ["kp_h11_complex_muldiv"], "difficulty": 0.7, "solution": "z=2/(1+i)=2(1-i)/[(1+i)(1-i)]=2(1-i)/2=1-i。", "source": "llm_generated"},
  {"id": "h_h11a_043", "item_type": "fill", "stem": "复数z=√3+i的模|z|=____，辐角主值θ=____。", "answer": "|z|=2，θ=π/6", "kps": ["kp_h11_complex_trig"], "difficulty": 0.2, "solution": "|z|=√((√3)²+1²)=√4=2；tanθ=1/√3，θ∈(0,π/2)，故θ=π/6。", "source": "llm_generated"},
  {"id": "h_h11a_044", "item_type": "choice", "stem": "复数z=2(cos(π/3)+isin(π/3))在复平面内对应的点为（　）", "options": ["A. (1,√3)", "B. (2,√3)", "C. (√3,1)", "D. (√3,2)"], "answer": "A", "kps": ["kp_h11_complex_trig"], "difficulty": 0.5, "solution": "z=2cos(π/3)+2sin(π/3)i=2×(1/2)+2×(√3/2)i=1+√3i，对应点(1,√3)。", "source": "llm_generated"},
  {"id": "h_h11a_045", "item_type": "fill", "stem": "若z₁=2(cos60°+isin60°)，z₂=3(cos30°+isin30°)，则z₁·z₂=____（用三角形式表示）。", "answer": "6(cos90°+isin90°)", "kps": ["kp_h11_complex_trig"], "difficulty": 0.7, "solution": "三角形式乘法：模相乘为2×3=6，辐角相加为60°+30°=90°，故z₁·z₂=6(cos90°+isin90°)。", "source": "llm_generated"},
  {"id": "h_h11a_046", "item_type": "choice", "stem": "下列几何体中，是棱柱的是（　）", "options": ["A. 三棱锥", "B. 圆柱", "C. 三棱柱", "D. 圆锥"], "answer": "C", "kps": ["kp_h11_solid_polyhedron"], "difficulty": 0.2, "solution": "三棱柱是棱柱；三棱锥是棱锥，圆柱是旋转体，圆锥是旋转体。", "source": "llm_generated"},
  {"id": "h_h11a_047", "item_type": "fill", "stem": "一个正四棱台的上底面边长为2，下底面边长为6，则它的侧面数为____。", "answer": "4", "kps": ["kp_h11_solid_polyhedron"], "difficulty": 0.5, "solution": "正四棱台有两个平行的四边形底面，连接上下底面对应顶点的4条侧棱，4个侧面都是等腰梯形，故侧面数为4。", "source": "llm_generated"},
  {"id": "h_h11a_048", "item_type": "choice", "stem": "下列说法中，正确的是（　）", "options": ["A. 有两个面平行，其余各面都是四边形的几何体一定是棱台", "B. 棱锥的侧棱长都相等", "C. 棱柱的两个底面平行且全等", "D. 棱台的所有侧棱都相等"], "answer": "C", "kps": ["kp_h11_solid_polyhedron"], "difficulty": 0.7, "solution": "A错，仅当侧面延长交于一点时才是棱台；B错，仅正棱锥侧棱相等；C对，棱柱定义要求两个底面平行且全等；D错，仅正棱台所有侧棱相等。", "source": "llm_generated"},
  {"id": "h_h11a_049", "item_type": "choice", "stem": "以矩形的一边所在直线为轴旋转一周得到的几何体是（　）", "options": ["A. 圆柱", "B. 圆锥", "C. 圆台", "D. 球"], "answer": "A", "kps": ["kp_h11_solid_rotation"], "difficulty": 0.2, "solution": "矩形绕其一边旋转一周形成的几何体是圆柱。", "source": "llm_generated"},
  {"id": "h_h11a_050", "item_type": "fill", "stem": "用一个平行于圆锥底面的平面截圆锥，截面与底面之间的部分称为____。", "answer": "圆台", "kps": ["kp_h11_solid_rotation"], "difficulty": 0.5, "solution": "圆台是用平行于圆锥底面的平面截圆锥，截面与底面之间的部分。", "source": "llm_generated"},
  {"id": "h_h11a_051", "item_type": "choice", "stem": "球的截面是（　）", "options": ["A. 圆面", "B. 三角形", "C. 长方形", "D. 圆周"], "answer": "A", "kps": ["kp_h11_solid_rotation"], "difficulty": 0.7, "solution": "球的任意截面都是圆面，不过球心的截面为小圆面，过球心的截面为最大圆面。", "source": "llm_generated"},
  {"id": "h_h11a_052", "item_type": "fill", "stem": "用斜二测画法画水平放置的平面图形的直观图时，原图中平行于x轴的线段在直观图中仍保持____（填\"长度不变\"或\"长度减半\"），平行于y轴的线段长度变为原来的____。", "answer": "长度不变，一半", "kps": ["kp_h11_solid_intuitive"], "difficulty": 0.2, "solution": "斜二测画法规则：x轴方向保持长度不变且平行性不变，y轴方向长度变为原来的一半，且y'轴与x'轴成45°。", "source": "llm_generated"},
  {"id": "h_h11a_053", "item_type": "choice", "stem": "用斜二测画法画一个面积为4的矩形的直观图，则直观图的面积为（　）", "options": ["A. 2", "B. 2√2", "C. 4", "D. √2"], "answer": "D", "kps": ["kp_h11_solid_intuitive"], "difficulty": 0.5, "solution": "斜二测画法下图形面积变为原面积的√2/4倍，故直观图面积为4×√2/4=√2。", "source": "llm_generated"},
  {"id": "h_h11a_054", "item_type": "fill", "stem": "用斜二测画法画水平放置的△ABC的直观图△A'B'C'，已知△A'B'C'的面积为√2，则原△ABC的面积为____。", "answer": "4", "kps": ["kp_h11_solid_intuitive"], "difficulty": 0.7, "solution": "斜二测画法下直观图面积是原面积的√2/4倍，故原面积=直观图面积÷(√2/4)=√2×4/√2=4。", "source": "llm_generated"},
  {"id": "h_h11a_055", "item_type": "choice", "stem": "圆柱的侧面积公式为（　）", "options": ["A. πr²", "B. πrh", "C. 2πrh", "D. πr²h"], "answer": "C", "kps": ["kp_h11_solid_surface"], "difficulty": 0.2, "solution": "圆柱侧面展开图为矩形，长为底面周长2πr，宽为高h，故侧面积=2πrh。", "source": "llm_generated"},
  {"id": "h_h11a_056", "item_type": "fill", "stem": "圆锥的底面半径为3，母线长为5，则它的侧面积为____（结果保留π）。", "answer": "15π", "kps": ["kp_h11_solid_surface"], "difficulty": 0.5, "solution": "圆锥侧面展开图为扇形，半径为母线长l=5，弧长为底面周长2πr=6π，侧面积=(1/2)×弧长×半径=(1/2)×6π×5=15π。", "source": "llm_generated"},
  {"id": "h_h11a_057", "item_type": "choice", "stem": "一个球的半径为3，则它的表面积为（　）", "options": ["A. 9π", "B. 36π", "C. 27π", "D. 12π"], "answer": "B", "kps": ["kp_h11_solid_surface"], "difficulty": 0.7, "solution": "球的表面积公式S=4πR²，代入R=3得S=4π×9=36π。", "source": "llm_generated"}
]
