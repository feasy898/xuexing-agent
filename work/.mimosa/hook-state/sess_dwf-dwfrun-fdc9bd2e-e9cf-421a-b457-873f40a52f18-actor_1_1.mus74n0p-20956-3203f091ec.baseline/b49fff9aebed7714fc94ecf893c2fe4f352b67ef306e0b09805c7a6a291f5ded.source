# ===== 33 史传散文（烛之武/鸿门宴） =====
S('kp_chi10_classical_prose',
  '翻译："若亡郑而有益于君，敢以烦执事。"（《烛之武退秦师》）',
  '如果灭掉郑国对您有好处，那就冒昧地拿这件事麻烦您（您手下的人）了。',
  '"亡"使动用法，使……灭亡；"执事"是对对方的敬称。', 0.66),
C('kp_chi10_classical_prose',
  '下列句中加点词解释正确的一项是',
  ['"若不阙秦"之"阙"：同"缺"，侵损、削减', '"越国以鄙远"之"鄙"：平庸', '"微夫人之力不及此"之"微"：轻微', '"焉用亡郑以陪邻"之"陪"：陪伴'],
  'A',
  '"鄙"为边邑，此处作意动，"把……当作边邑"；"微"为"（假如）没有"；"陪"通"倍"，增加。', 0.68),
S('kp_chi10_classical_prose',
  '《烛之武退秦师》中，烛之武劝说秦伯的论证有何层次？请简析。',
  '烛之武先示卑（"敢以烦执事"）消除戒心；继而晓以利害，分三层：①亡郑只利晋，越国鄙远难以管理；②存郑可为秦"东道主"，供其使者往来之资；③晋国贪得无厌，"阙秦以利晋"不可不防。层层推进，处处从秦国利益出发，终使秦伯退兵。',
  '抓住"示卑—说害—言利—析晋"的逻辑推进。', 0.74),

# ===== 34 科技人文论著 =====
C('kp_chi10_science_hum',
  '对《一名物理学家的教育历程》中"鲤鱼科学家"寓言的理解，不正确的一项是',
  ['鲤鱼世界中的物理学家也会总结出"食物从上面落下"等"定律"',
   '寓言讽刺的是视野受限而不自知的认知局限',
   '作者借此说明观察受限于观察者的位置，科学需要不断突破固有维度',
   '鲤鱼最终能够理解人类的思维与情感'],
  'D',
  '鲤鱼无法越出池面理解"另一个世界"，正如人也难以跳出自身认知的局限，因此D项错误。', 0.58),
S('kp_chi10_science_hum',
  '"鲤鱼科学家"的想象对作者走上科学探索之路有何作用？请结合《一名物理学家的教育历程》简析。',
  '童年的水池观察使作者第一次意识到"维度"的局限：鲤鱼所信的"真理"只因身在池中。这一想象培养了作者对"看不见的世界"的敏感，使他日后对高维空间产生强烈好奇，也提示他：真正的科学探索要有跳出常识、反思前提的勇气。',
  '答出：①启发"突破认知维度"的意识，②孕育对高维空间的兴趣，③科学想象与实证的关系。', 0.7),

# ===== 35 演说与奏疏书信阅读 =====
C('kp_chi10_speech_politics',
  '关于《谏太宗十思疏》，下列分析正确的一项是',
  ['文章开篇以"求木之长者，必固其根本"作类比，引出"思国之安者，必积其德义"的论点',
   '作者反对君主做任何自我约束',
   '全文以抒情为主，通过反复咏叹打动太宗',
   '"十思"是十条应付百姓的具体措施'],
  'A',
  '魏征以"树木—河源"类比，提出"居安思危，戒奢以俭"的主张；"十思"是对君主修养而言。', 0.6),
S('kp_chi10_speech_politics',
  '《在〈人民报〉创刊纪念会上的演说》中，马克思既肯定工业与技术的力量，又揭示工人的苦难。请说说这种"两面顾到"的论述效果。',
  '马克思通过1848年革命的力量展示科学技术的伟力，又指出这种伟力是以工人的贫困为代价取得的；两面并置，一方面说明无产阶级掌握科学后的光明前景，一方面揭露资本主义生产关系的病态，使演说既有历史的纵深感，又有现实批判的锋芒，极具号召力。',
  '要点：①肯定生产力伟力，②揭示代价，③面向无产阶级的前景。', 0.72),

# ===== 36 《祝福》 =====
C('kp_chi10_fiction_zhufu',
  '关于《祝福》内容，下列分析不正确的一项是',
  ['小说以"我"的见闻串联祥林嫂的半生，采用第一人称叙述',
   '祥林嫂的命运转折都与封建礼教对"节烈"的要求直接相关',
   '鲁镇年终的"祝福"热闹与她寂然死去形成强烈反差',
   '"我"对祥林嫂的追问给出了明确的答案，帮助她解除了恐惧'],
  'D',
  '"我"以"说不清"搪塞，正反映知识分子面对礼教秩序时的软弱与逃避。', 0.58),
S('kp_chi10_fiction_zhufu',
  '结合全文，概括造成祥林嫂悲剧的社会原因。',
  '①婆婆可将她捆绑发卖，说明封建婚姻制度下妇女毫无人身自由；②嫁过两个男人即被视为"不干净"，即便捐了门槛也跨不过祭祀的门槛，是夫权与礼教的规定；③柳妈以"锯成两半"的恐吓摧毁她的精神，属神权的压迫；④鲁镇人把她的苦难当作谈资咀嚼，社会的凉薄使她孤立无援。多重压迫叠加，使她求生不能、求死不得。',
  '从夫权/族权、神权、社会凉薄任答两层。', 0.72),

# ===== 37 《林教头风雪山神庙》 =====
C('kp_chi10_fiction_linchong',
  '《林教头风雪山神庙》写"那雪正下得紧"的环境描写，作用分析不当的一项是',
  ['渲染紧张气氛，推动情节向高潮发展',
   '以风雪之"紧"衬托林冲被逼上梁山的愤懑与决绝',
   '为使林冲去打酒才写大雪，纯属交代天气',
   '大雪压塌草厅，直接迫使林冲投奔山神庙，情节环环相扣'],
  'C',
  '风雪不只是天气：它推动情节（买酒—担草—压塌山神庙）、烘托人物心理，是叙事动力。', 0.55),
S('kp_chi10_fiction_linchong',
  '林冲"风雪山神庙"手刃仇敌之前，经历了怎样的性格变化？请结合情节概述。',
  '林冲原是安分守己的禁军教头，侥幸心理极强：高衙内调戏其妻，他"权且忍过"；误入白虎堂被刺配，仍想服完刑回家；直到陆谦等人追至沧州、火烧草料场欲置其于死地，他才彻底绝望，于风雪之夜手刃三人。这一"忍—逼—反"的过程，使"逼上梁山"的主题极具说服力。',
  '写出"委曲求全—被逼—反抗"的转折链条。', 0.7),

# ===== 38 《装在套子里的人》 =====
S('kp_chi10_biezhiliu',
  '别里科夫有哪些"套子"式言行？作者借此塑造了怎样的典型形象？',
  '"套子"既有形的：晴天穿雨鞋、带雨伞，穿暖和的棉大衣，脸藏在竖起的衣领里，戴黑眼镜，穿羊毛衫，堵耳朵眼，一坐上马车就吩咐支起车篷；也有无形的：歌颂过去、害怕一切新事物，用"千万别闹出什么乱子"辖制同事、辖制全城。作者塑造了一个因循守旧、敌视新生事物、甘当沙皇专制警察的典型，是"套中人"的代名词。',
  '抓住"有形套子+无形套子"两层及典型意义。', 0.66),

# ===== 39 《促织》《变形记》 =====
C('kp_chi10_cuzhi',
  '《促织》与《变形记》都用了"变形"的情节，下列分析正确的一项是',
  ['两篇小说中的变形都由主人公主动选择',
   '《促织》写人变虫，使成名一家的悲欢与虚幻的希望交织，具有强烈的批判性',
   '《变形记》写人变虫，表现的是人对虫类的羡慕',
   '两篇都在歌颂科学技术带给人的异化好处'],
  'B',
  '《促织》落魄子魂化促织，带有"求神问卜""因果报应"的虚幻色彩；《变形记》则是现代社会异化的真实寓言。', 0.66),
S('kp_chi10_cuzhi',
  '比较阅读《促织》与《变形记》中的"变形"，说说二者批判指向有何不同。',
  '《促织》中人魂化促织以求"一鸣惊人"，成名一家因小小蟋蟀贫富翻转，批判的是封建官府与科举思维对下层百姓的压迫，以及人在命运面前的无力；《变形记》写格里高尔变成甲虫后被家人嫌弃，批判的是资本主义社会人的工具化与亲情的冷漠。前者借虚幻的变形写现实的荒谬，后者用真实的变形写异化的悲剧。',
  '比较点：①变动的起因与结局，②批判对象（封建压迫／现代异化）。', 0.76),

# ===== 40 《红楼梦》 =====
C('kp_chi10_honglou',
  '"可叹停机德，堪怜咏絮才"这一判词评价的人物是',
  ['薛宝钗、林黛玉', '贾宝玉、林黛玉', '王熙凤、薛宝钗', '史湘云、薛宝钗'],
  'A',
  '"停机德"用乐羊子妻停机劝学的典故，赞宝钗之德；"咏絮才"用谢道韫典故，赞黛玉之才。', 0.55),
S('kp_chi10_honglou',
  '清人评《红楼梦》"悲凉之雾，遍彼华林"。请结合一个具体情节，谈谈你对这一判断的理解。',
  '示例：宝玉与黛玉共读《西厢》，桃花树下青春正好，但紧接着黛玉母亲病逝、寄居贾府的处境，已埋下"求而不得"的伏笔；又如"黛玉葬花"以最洁净的诗意行为书写生命最彻底的消逝。繁华与青春的短暂反衬出悲剧的必然——大观园终究"食尽鸟投林"。',
  '须以具体情节印证"繁华—逝去"的反差，忌空泛。', 0.74),

]
