"""Generate biology HS candidate questions.

Each entry: (form, stem, options_or_None, answer, solution, difficulty)
- form: 'mcq_single' | 'mcq_multi' | 'fill' | 'solve'
- options: list of strings or None
- answer: 'A' | 'A,B' | 'fill text' | 'solve answer text'
"""
import json
import os

ROOT = r"D:\new-workspace\学情agent\xuexing-agent"
KNOW = os.path.join(ROOT, "data", "knowledge")
OUT = os.path.join(ROOT, "data", "verification", "candidates_bio")

# Each KP -> 3 questions: (mcq_single, mcq_multi, fill_or_solve)
# Difficulty within [0.40, 0.85]
# Note: difficulty per prompt: 高中 0.4-0.85

QS = {}


def add(kp_id, q1, q2, q3):
    QS[kp_id] = [q1, q2, q3]


# ============================================================
# Grade 10 (必修1+必修2)  46 KPs
# ============================================================

# kp_bio10_cell_elements 组成细胞的元素
add("kp_bio10_cell_elements",
