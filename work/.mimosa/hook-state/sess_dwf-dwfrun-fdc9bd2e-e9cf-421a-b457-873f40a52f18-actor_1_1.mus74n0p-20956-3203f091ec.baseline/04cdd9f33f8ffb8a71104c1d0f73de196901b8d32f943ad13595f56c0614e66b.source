#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Build geo_jr candidate batch for junior high geography (grade 7-8, 部编/统编人教版).
Each KP gets 2-3 questions: typically 1 choice + 1 fill, some with extra solve or mcq_multi.
"""
import json
import os

ROOT = r"D:\new-workspace\学情agent\xuexing-agent"
KP_FILES = [
    os.path.join(ROOT, 'data/knowledge/geography_grade7.json'),
    os.path.join(ROOT, 'data/knowledge/geography_grade8.json'),
]
OUT_DIR = os.path.join(ROOT, 'data/verification/candidates_geo')

# Format: QUESTIONS[kp_id] = [(form, stem, options_or_None, answer, difficulty, solution), ...]
# form ∈ {mcq_single, fill, solve_short, solve_comprehensive, mcq_multi}
QUESTIONS = {}

# =========================================================
# GRADE 7 — 第一章：地球与地图
# =========================================================

